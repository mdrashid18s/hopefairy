# HopeFairy — Enterprise Repository Git Ignore Rules
# Strictly prevents secret leaks, build artifacts, and transient dependencies

# 1. Sensitive Environment Files & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.cer
*.crt
auth.json

# 2. Dependencies & Package Managers
node_modules/
**/node_modules/
vendor/
**/vendor/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 3. Next.js & Frontend Build Outputs
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/
*.tsbuildinfo
next-env.d.ts
.vercel/

# 4. Laravel Backend Storage & Caches
apis/storage/app/*
!apis/storage/app/.gitignore
apis/storage/framework/cache/*
!apis/storage/framework/cache/.gitignore
apis/storage/framework/sessions/*
!apis/storage/framework/sessions/.gitignore
apis/storage/framework/views/*
!apis/storage/framework/views/.gitignore
apis/storage/logs/*
!apis/storage/logs/.gitignore
apis/bootstrap/cache/*
!apis/bootstrap/cache/.gitignore
!apis/bootstrap/cache/.gitkeep
apis/public/storage
apis/public/hot

# 5. Distributable Binary Archives (Kept local, not tracked in git)
dist_zips/*.zip
*.zip
*.tar.gz
*.rar

# 6. Scratch & Temporary Files
scratch/
**/.temp/
**/.tmp/

# 7. Testing, Logs & Debugging
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.phpunit.result.cache
.phpunit.cache/

# 8. OS & Editor Artifacts
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
